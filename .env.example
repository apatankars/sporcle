# Telegram bot token from @BotFather. Leave blank to use console mode.
TELEGRAM_BOT_TOKEN=
# Your chat id. Leave blank, message the bot once, and it will tell you.
TELEGRAM_CHAT_ID=

# The name your team sees when the bot asks to join.
BOT_NAME=Recorder

# DASH_URL=https://www.sporcle.com/dash/
# HEADLESS=true                  # false to watch the browser work
# BROWSER_PROFILE_DIR=browser-profile   # only if Dash needs a Sporcle login (then run: npm run login)
# OUT_DIR=games
# POLL_MS=1000                   # how often to check the screen
# APPROVAL_TIMEOUT_MIN=20
# MAX_PARTS=15                   # max "next arrow" clicks per question
# STEP_SCREENSHOTS=true          # text a screenshot after each join step
# NOTIFY_EACH_QUESTION=true      # text a preview of each question
# STOP_AFTER_GAME_OVER_SEC=60
